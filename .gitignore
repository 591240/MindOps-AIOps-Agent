# ---- 依赖与虚拟环境 ----
.venv/
__pycache__/
*.py[cod]
node_modules/

# ---- 构建产物与本地缓存 ----
dist/
.tsbuildinfo
*.tsbuildinfo
.pytest_cache/
.pytest-tmp/
.tanstack/

# ---- 密钥：绝不进仓库（.env 含真实 SMTP 授权码 / JWT / Fernet 主密钥）----
.env
.env.*
!.env.example
!.env.production.example

# ---- 运行时数据与备份（含口令哈希、验证码表全量数据）----
mindops-backend/data/*
# 评测集是项目的一部分，必须进仓库
!mindops-backend/data/eval/
*.sql
*.db
*.sqlite
embedding_cache.json

# ---- 本地临时输出与材料（与源码无关）----
*_out.txt
eval_result.json
eval_report.txt
eval_result.*.json
eval_report.*.txt

# ---- 历史版本备份：体积大且含旧代码，不进仓库 ----
_backup/
output/
答辩PPT/
*.log
.DS_Store

# ---- 各类助手工具目录 ----
.workbuddy/
.workbuddy-ai/
.zcode/

# ---- 私人材料：按方案 B 不进公开仓库（本地文件不受影响，删掉本段即恢复）----
