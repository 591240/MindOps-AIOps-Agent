# MindOps 生产环境配置模板
#
# 用法：
#   cp mindops-backend/.env.production.example mindops-backend/.env.production
#   填写所有 CHANGE_ME_* 项
#   docker compose --env-file mindops-backend/.env.production up -d --build
#
# 该文件含密钥，绝不能提交到仓库（.gitignore 已忽略 .env.*，仅保留 *.example）。
# 生成密钥：
#   JWT:       python -c "import secrets;print(secrets.token_urlsafe(48))"
#   Webhook:   python -c "import secrets;print(secrets.token_urlsafe(32))"
#   Vault:     python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# ---- 运行模式 ----
MINDOPS_DEBUG=false

# ---- MySQL（compose 内使用服务名 mysql）----
MINDOPS_MYSQL_HOST=mysql
MINDOPS_MYSQL_PORT=3306
MINDOPS_MYSQL_USER=mindops
MINDOPS_MYSQL_DB=mindops
MINDOPS_MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# 仅 MySQL 容器初始化使用；后端不读取
MINDOPS_MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# ---- Redis（生产必须启用：跨请求去重/限流/黑名单/SSE 广播）----
MINDOPS_REDIS_URL=redis://redis:6379/0

# ---- 向量库（容器内纯 ASCII 路径）----
MINDOPS_MILVUS_URI=/app/data/milvus_lite.db

# ---- 安全密钥 ----
MINDOPS_JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
MINDOPS_LLM_VAULT_KEY=CHANGE_ME_FERNET_KEY
MINDOPS_WEBHOOK_TOKEN=CHANGE_ME_RANDOM_TOKEN

# ---- 跨域 ----
# 前端与 API 走同一个 Nginx 域名时同源，无需 CORS，可留空。
# 若前后端分域部署，填前端公网来源，例如 https://mindops.example.com
MINDOPS_CORS_ORIGINS=

# ---- 认证与注册 ----
# 生产禁止"登录即注册"
MINDOPS_AUTH_ALLOW_AUTO_REGISTER=false
# 公网默认关闭自助注册（防止陌生人注册后触发诊断/上传知识消耗模型额度）。
# 首次建管理员：临时改为 true，并填 BOOTSTRAP_ADMIN_EMAIL，用该邮箱注册；
# 拿到 admin 后改回 false 并重启。
MINDOPS_REGISTER_ENABLED=false
MINDOPS_BOOTSTRAP_ADMIN_EMAIL=

# ---- 邮箱验证码（登录 / 注册）----
MINDOPS_EMAIL_PROVIDER=smtp
MINDOPS_EMAIL_SMTP_HOST=smtp.qq.com
MINDOPS_EMAIL_SMTP_PORT=465
MINDOPS_EMAIL_SMTP_USER=CHANGE_ME@qq.com
# QQ 邮箱「授权码」，不是登录密码
MINDOPS_EMAIL_SMTP_PASSWORD=CHANGE_ME_SMTP_AUTH_CODE
MINDOPS_EMAIL_FROM_NAME=MindOps
MINDOPS_EMAIL_CODE_TTL=300
MINDOPS_EMAIL_SEND_INTERVAL=60
MINDOPS_CODE_SEND_IP_PER_MIN=4

# ---- 镜像构建 ----
# 国内服务器建议改成清华源；留默认值则从 pypi.org 直连，可能长时间卡住。
# MINDOPS_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
MINDOPS_PIP_INDEX_URL=https://pypi.org/simple

# ---- 可观测性 ----
# /metrics 生产未设置 token 时只允许回环/私网直连；经公网反代暴露时请设置，
# 并让 Prometheus 带 X-Metrics-Token 头。
MINDOPS_METRICS_TOKEN=
MINDOPS_STREAM_TICKET_TTL_SECONDS=300

# ---- 明确不要设置 ----
# MINDOPS_SEED_DEMO_USERS=1 会写入固定口令的演示管理员，公网部署绝不能开。
